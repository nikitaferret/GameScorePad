# Портативный runtime Python (22 МБ бинарников).
# Не хранится в репозитории — восстанавливается скриптом scripts/get-runtime.ps1
runtime/

# Python
__pycache__/
*.py[cod]
*.pyo

# Мусор Windows
desktop.ini
Thumbs.db
*.lnk

# macOS
.DS_Store

# Пользовательские фоны зала и комплекты оформления — не для репозитория.
# Папка bg/ нужна приложению, поэтому оставляем в ней только .keep
bg/*
!bg/.keep

# Логи и временное
*.log
tmp/
